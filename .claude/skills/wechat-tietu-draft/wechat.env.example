# 公众号贴图草稿 skill 的凭证模板
# 用法：复制本文件到 C:\Users\WFL\.workbuddy\wechat.env 并填入真实值。
# 或者设环境变量 WECHAT_APPID / WECHAT_SECRET（优先级更高）。
#
# 获取入口：developers.weixin.qq.com/platform
#   → 我的业务与服务 → 公众号 → 基础信息 → 开发密钥
#   管理员微信扫码生成，AppSecret 只明文显示一次，务必立刻保存。
# 同一页面还要配置「API IP 白名单」，把跑脚本机器的公网出口 IP 加进去，
# 否则调用返回 40164。自查出口 IP：curl ifconfig.me
#
# ⚠️ 安全红线：不要提交到 git、不要写进代码、不要贴到聊天/日志里。

WECHAT_APPID=wxXXXXXXXXXXXXXXXX
WECHAT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
