# 备份文件不上传（保留本地个人画像）
*.backup.md
*.backup.*

# 输入文件不上传（可能包含未公开的报告/数据）
输入/*
!输入/.gitkeep

# 输出报告不上传（可能含敏感分析）
输出/*
!输出/.gitkeep

# Claude 本地权限设置（每台机器不同）
.claude/settings.local.json

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 临时文件
*.tmp
*.log
~$*

# 压缩包（Skill 源码包，解压后可删除）
*.zip

# Skill 运行期状态（含 access_token 缓存与已投记录，严禁入库）
.claude/skills/**/.state/
**/__pycache__/
*.pyc
